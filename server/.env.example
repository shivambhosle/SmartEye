PORT=3000
# Replace with your MongoDB connection string (e.g. MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/smarteye
JWT_SECRET=smarteye_dev_jwt_secret_key_2026
GEMINI_API_KEY=your_gemini_api_key_here
LOCAL_MODEL_URL=http://localhost:8001

# --- Optional Status & OTP Email Notifications ---
# If omitted, notifications and OTPs are cleanly logged in your dev server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartEye Civic Care" <no-reply@smarteye.local>

# --- Optional Cloudflare Turnstile Anti-Bot ---
# If omitted, human verification operates in development bypass mode
TURNSTILE_SECRET_KEY=
